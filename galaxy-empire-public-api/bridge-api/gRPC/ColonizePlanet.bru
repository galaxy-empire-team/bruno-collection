meta {
  name: ColonizePlanet
  type: grpc
  seq: 2
}

grpc {
  url: {{uri}}:{{gRPCPort}}
  method: /planet.v1.PlanetService/ColonizePlanet
  body: grpc
  auth: none
  methodType: unary
}

body:grpc {
  name: message 1
  content: '''
    {
      "operationID": 2,
      "userID": "{{userID}}",
      "coordinates": {
        "x": 1,
        "y": 2,
        "z": 3
      },
      "resources": {
        "metal": 100,
        "crystal": 100,
        "gas": 100
      },
      "isCaplitol": false
    }
  '''
}
