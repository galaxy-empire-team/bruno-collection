meta {
  name: Recycle
  type: http
  seq: 6
}

post {
  url: {{uri}}:{{port}}/api/v1/mission/recycle
  body: json
  auth: inherit
}

body:json {
  {
    "planetFrom": "{{planetID}}",
    "planetTo": {
      "X": 1,
      "Y": 1,
      "Z": 1
    },
    "fleet": [
      {
        "id": 1,
        "count": 10
      }
    ],
    "speedMultiplier": 1
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
