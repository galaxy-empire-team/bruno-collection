meta {
  name: Colonize
  type: http
  seq: 3
}

post {
  url: {{uri}}:{{port}}/api/v1/mission/colonize
  body: json
  auth: inherit
}

body:json {
  {
    "planetFrom": "{{planetID}}",
    "planetTo": {
      "X": 0,
      "Y": 0,
      "Z": 0
    },
    "cargo": {
      "metal": 100,
      "crystal": 100,
      "gas": 100
    },
    "fleet": [
      {
        "id": 1,
        "count": 10
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
