meta {
  name: Transport
  type: http
  seq: 5
}

post {
  url: {{uri}}:{{port}}/api/v1/mission/transport
  body: json
  auth: inherit
}

body:json {
  {
    "planetFrom": "{{planetID}}",
    "planetTo": {
      "X": 1,
      "Y": 1,
      "Z": 1
    },
    "cargo": {
      "metal": 100,
      "crystal": 100,
      "gas": 100
    },
    "fleet": [
      {
        "id": 1,
        "count": 10
      }
      ],
    "speedMultiplier": 1
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
