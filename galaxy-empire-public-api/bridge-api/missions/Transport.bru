meta {
  name: Transport
  type: http
  seq: 5
}

post {
  url: {{uri}}:{{port}}/api/v1/mission/transport
  body: json
  auth: inherit
}

body:json {
  {
    "planetFrom": "{{planetID}}",
    "planetTo": {
      "X": 0,
      "Y": 2,
      "Z": 14
    },
    "cargo": {
      "metal": 100,
      "crystal": 100,
      "gas": 100
    },
    "fleet": [
      {
        "id": 3,
        "count":5
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
