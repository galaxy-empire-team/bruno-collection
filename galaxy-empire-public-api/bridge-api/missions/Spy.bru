meta {
  name: Spy
  type: http
  seq: 4
}

post {
  url: {{uri}}:{{port}}/api/v1/mission/attack
  body: json
  auth: inherit
}

body:json {
  {
    "planetFrom": "{{planetID}}",
    "planetTo": {
      "X": 0,
      "Y": 2,
      "Z": 14
    },
    "fleet": [
      {
        "id": 1,
        "count":30
      },
      {
        "id": 2,
        "count":100
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
