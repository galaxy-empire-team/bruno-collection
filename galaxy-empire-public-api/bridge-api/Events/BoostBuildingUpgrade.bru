meta {
  name: BoostBuildingUpgrade
  type: http
  seq: 8
}

post {
  url: {{uri}}:{{port}}/api/v1/event/building/boost
  body: json
  auth: inherit
}

body:json {
  {
    "planetID": "{{planetID}}",
    "buildingID": 1,
    "boost": {
      "id": 1,
      "count": 1
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
